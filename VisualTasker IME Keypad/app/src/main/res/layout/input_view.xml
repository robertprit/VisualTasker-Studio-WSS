<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#111111">

    <com.visualtasker.ime.ime.toolbar.SwipeToolbarView
        android:id="@+id/swipeToolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#19171F" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <android.inputmethodservice.KeyboardView
            android:id="@+id/keyboardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:keyBackground="@drawable/key_bg_dark"
            android:keyTextColor="@android:color/white"
            android:keyTextSize="18sp"
            android:padding="2dp" />

        <LinearLayout
            android:id="@+id/rightNumpadPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/numpad7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" />
                <Button android:id="@+id/numpad8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" />
                <Button android:id="@+id/numpad9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/numpad4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" />
                <Button android:id="@+id/numpad5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" />
                <Button android:id="@+id/numpad6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/numpad1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" />
                <Button android:id="@+id/numpad2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" />
                <Button android:id="@+id/numpad3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button android:id="@+id/numpadMinus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="-" />
                <Button android:id="@+id/numpad0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="0" />
                <Button android:id="@+id/numpadPlus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="+" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/inlineToolSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        android:background="#1C1C1C">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@android:color/darker_gray" />

        <TextView
            android:id="@+id/inlineSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tools"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/inlineSheetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</LinearLayout>
