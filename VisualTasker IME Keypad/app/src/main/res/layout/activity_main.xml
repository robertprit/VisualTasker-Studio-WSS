<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_ime_hint"
            android:textSize="16sp" />

        <Button
            android:id="@+id/openSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/open_input_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Darstellung"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/darkKeyboardSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dunkle Tastatur aktivieren" />

        <Switch
            android:id="@+id/colorArgbSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Colorpicker mit Alpha (AARRGGBB) einfügen" />

        <Switch
            android:id="@+id/clipboardHistorySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clipboard-History aktivieren" />

        <Switch
            android:id="@+id/emscriptModeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EMScript-Kontext auto-erkennen" />

        <Switch
            android:id="@+id/visionTaskerModeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VisionTasker-Kontext auto-erkennen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sondertastenbelegung (vollständige Android-Keycodes)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="S1 (-210)"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinnerSpecial210"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="S2 (-211)"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinnerSpecial211"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="S3 (-212)"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinnerSpecial212"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="S4 (-213)"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinnerSpecial213"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="VisualTasker-Tasten"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/vtSlot1Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kurzes Label für VT1"
            android:inputType="text"
            android:maxLength="6"
            android:singleLine="true" />

        <EditText
            android:id="@+id/vtSlot1Script"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="EMScript für VT1"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2" />

        <EditText
            android:id="@+id/vtSlot2Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Kurzes Label für VT2"
            android:inputType="text"
            android:maxLength="6"
            android:singleLine="true" />

        <EditText
            android:id="@+id/vtSlot2Script"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="EMScript für VT2"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Einstellungen speichern" />

    </LinearLayout>
</ScrollView>
